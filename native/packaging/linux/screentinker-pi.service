[Unit]
Description=LuminaScreen native signage player
Documentation=https://luminascreen.ru/guides/raspberry-pi-digital-signage
After=network-online.target systemd-user-sessions.service
Wants=network-online.target
# The player owns the display over KMS; a console login on tty1 would fight it for the screen.
Conflicts=getty@tty1.service
After=getty@tty1.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=luminascreen
Group=luminascreen
SupplementaryGroups=video render input audio
RuntimeDirectory=luminascreen-pi
Environment=XDG_RUNTIME_DIR=/run/luminascreen-pi
Environment=ST_STATE_DIR=/var/lib/luminascreen-pi
Environment=HOME=/var/lib/luminascreen-pi
ExecStart=/usr/bin/luminascreen-pi run
Restart=always
RestartSec=3
# A player that hangs (a wedged decoder deep in GStreamer) must not stay hung: the heartbeat thread
# keeps working, so this is the backstop for the Qt thread only.
TimeoutStopSec=15
KillMode=mixed

[Install]
WantedBy=multi-user.target
