{
    "$comment": "Schema for templates between 1.0.18 and 1.1.0",
    "definitions": {
        "image-required-properties": {
            "if": {
                "type": "object",
                "properties": {
                    "type": { "const": "image"}
                }
            },
            "then": {
                "type": "object",
                "required": ["id", "type", "scale", "image", "position", "angle", "zIndex"]
            }
        },
        "internalphoto-required-properties": {
            "if": {
                "type": "object",
                "properties": {
                    "type": { "const": "internalphoto"}
                }
            },
            "then": {
                "type": "object",
                "required": ["id", "type", "width", "height"]
            }
        },
        "internalsvg-required-properties": {
            "if": {
                "type": "object",
                "properties": {
                    "type": { "const": "internalsvg"}
                }
            },
            "then": {
                "type": "object",
                "required": ["id", "type", "width", "height", "colors"]
            }

        },
        "qrcode-required-properties": {
            "if": {
                "type": "object",
                "properties": {
                    "type": { "const": "qrcode"}
                }
            },
            "then": {
                "type": "object",
                "required": ["type", "url", "color", "backgroundColor", "symbol"]
            }

        },
        "urlphoto-required-properties": {
            "if": {
                "type": "object",
                "properties": {
                    "type": { "const": "urlphoto"}
                }
            },
            "then": {
                "type": "object",
                "required": ["type", "width", "height", "url"],
                "properties": {
                    "url": {
                        "type": "string",
                        "pattern": "^data:image\/(jpeg|png);base64,(?:[A-Za-z0-9+\/]{4})*(?:[A-Za-z0-9+\/]{4}|[A-Za-z0-9+\/]{3}=|[A-Za-z0-9+\/]{2}={2})$"
                    }
                }
            }
        },
        "text-required-properties": {
            "if": {
                "type": "object",
                "properties": {
                    "type": { "const": "text"}
                }
            },
            "then": {
                "type": "object",
                "required": [
                    "id",
                    "type",
                    "color",
                    "justification",
                    "size",
                    "position",
                    "angle",
                    "background",
                    "zIndex",
                    "text"
                ]
            }
        },
        "emoji-required-properties": {
            "if": {
                "type": "object",
                "properties": {
                    "type": { "const": "emoji" }
                }
            },
            "then" : {
                "type": "object",
                "required": [
                    "id",
                    "text",
                    "scale",
                    "angle",
                    "position"
                ]
            }
        },
        "shape-required-properties": {
            "if": {
                "type": "object",
                "properties": {
                    "type": { "const": "shape" }
                }
            },
            "then" : {
                "type": "object",
                "required": [
                    "id",
                    "zIndex",
                    "shape",
                    "fill",
                    "position"
                ]
            }
        },
        "image-schema": {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "enum": ["internalsvg", "internalphoto", "urlphoto", "qrcode", "emoji"]
                },
                "id": {
                    "type": "string"
                },
                "colors": {
                    "type": "object",
                    "patternProperties": {
                        "#(\\d|\\D){6}$": {
                            "type": "string",
                            "pattern": "^#(\\d|\\D){6}$"
                        }
                    }
                },
                "width": {
                    "type": "number"
                },
                "height": {
                    "type": "number"
                },
                "url": {
                    "type": "string"
                },
                "color": {
                    "type": "string",
                    "pattern": "^#(\\d|\\D){6}$"
                },
                "backgroundColor": {
                    "type": "string",
                    "pattern": "^#(\\d|\\D){6}$"
                },
                "symbol": {
                    "type": "object",
                    "properties": {
                        "id": {
                            "type": "string"
                        },
                        "colors": {
                            "type": "object",
                            "patternProperties": {
                                "#(\\d|\\D){6}$": {
                                    "type": "string",
                                    "pattern": "^#(\\d|\\D){6}$"
                                }
                            }
                        }
                    },
                    "additionalProperties": false,
                    "oneOf": [
                        {
                            "required": ["id", "colors"]
                        },
                        {
                            "required": [],
                            "properties": {},
                            "additionalProperties": false
                        }
                    ]
                }
            },
            "additionalProperties": false,
            "allOf": [
                { "$ref": "#/definitions/internalsvg-required-properties" },
                { "$ref": "#/definitions/internalphoto-required-properties" },
                { "$ref": "#/definitions/urlphoto-required-properties" },
                { "$ref": "#/definitions/qrcode-required-properties" },
                { "$ref": "#/definitions/emoji-required-properties" }
            ]
        }
    },
    "type": "object",
    "properties": {
        "version": {
            "type": "string",
            "pattern": "^1\\.0\\.\\d+$"
        },
        "document": {
            "type": "object",
            "properties": {
                "format": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "resolution": {
                    "type": "number"
                },
                "width": {
                    "type": "number"
                },
                "height": {
                    "type": "number"
                },
                "background": {
                    "$ref": "#/definitions/image-schema"
                }
            }
        },
        "components": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string",
                        "enum": ["image", "text", "shape"]
                    },
                    "scale": {
                        "type": "number"
                    },
                    "angle": {
                        "type": "number"
                    },
                    "zIndex": {
                        "type": "number"
                    },
                    "position": {
                        "type": "object",
                        "properties": {
                            "x": {
                                "type": "number"
                            },
                            "y": {
                                "type": "number"
                            }
                        },
                        "required": ["x", "y"],
                        "additionalProperties": false
                    },
                    "image": {
                        "$ref": "#/definitions/image-schema"
                    },
                    "color": {
                        "type": "string",
                        "pattern": "^#(\\d|\\D){6}$"
                    },
                    "justification": {
                        "type": "string",
                        "enum": ["center", "left", "right"]
                    },
                    "text": {
                        "type": "string"
                    },
                    "font": {
                        "type": "string"
                    },
                    "size": {
                        "type": "number"
                    },
                    "shape": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string",
                                "enum": ["circle"]
                            },
                            "options": {
                                "type": "object",
                                "properties": {
                                    "radius": {
                                        "type": "number"
                                    }
                                },
                                "additionalProperties": false,
                                "required": ["radius"]
                            }
                        },
                        "additionalProperties": false,
                        "required": ["type", "options"]
                    },
                    "fill": {
                        "type": "object",
                        "properties": {
                            "type": {
                                "type": "string",
                                "enum": ["blur"]
                            },
                            "options": {
                                "type": "object",
                                "properties": {
                                    "size": {
                                        "type": "number"
                                    }
                                },
                                "additionalProperties": false,
                                "required": ["size"]
                            }
                        }
                    },
                    "background": {
                        "type": "object",
                        "$comment": "Only if type === text",
                        "properties": {
                            "enabled": { "type": "boolean" },
                            "color": {
                                "type": "string",
                                "pattern": "^#(\\d|\\D){6}$"
                            },
                            "padding": {
                                "type": "number"
                            },
                            "distortion": {
                                "type": "array",
                                "items": {
                                    "type": "array",
                                    "items": [
                                        { "type": "number" },
                                        { "type": "number" }
                                    ],
                                    "minItems": 2,
                                    "additionalItems": false
                                }
                            },
                            "angleDistortion": {
                                "type": "number"
                            }
                        },
                        "required": ["enabled", "color", "padding", "distortion"],
                        "additionalProperties": false
                    }
                },
                 "allOf": [
                    { "$ref": "#/definitions/image-required-properties" },
                    { "$ref": "#/definitions/text-required-properties" },
                    { "$ref": "#/definitions/shape-required-properties" }
                ],
                "additionalProperties": false
            }
        }
    },
    "required": ["version"],
    "additionalProperties": false
}