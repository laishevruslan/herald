  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --p ./tsconfig-build.json && vite build && echo Last build:$(date)",
    "preview": "vite preview",
    "test": "vitest --mode headless",
    "test:ui": "vitest --ui --coverage --mode headless --coverage.enabled=true --coverage.reporter=html",
    "test:coverage": "vitest run --coverage --mode headless",
    "test:report": "vitest run --coverage --mode headless --reporter junit --outputFile=report.xml",
    "serve:assets": "cd tests/assets;http-server . -p 5050 --cors 'Access-Control-Allow-Origin *'",
    "docs": "typedoc"
  },
